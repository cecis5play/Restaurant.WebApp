@model IEnumerable<OrderViewModel>

<div class="container my-5">
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="mb-4">
            <a asp-area="" asp-controller="Admin" asp-action="AllOrders" class="btn btn-success">
                <i class="fas fa-users-cog me-2"></i> Управление на клиентски поръчки
            </a>
        </div>
    }

    <h2 class="text-center mb-5 display-5 fw-bold">📋 Вашите поръчки</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center">
            <img src="https://cdn-icons-png.flaticon.com/512/3153/3153898.png" alt="Няма поръчки" style="max-width: 200px; margin-bottom: 20px;">
            <div class="alert alert-warning rounded-pill shadow-sm px-4 py-2 d-inline-block">
                <i class="fas fa-box-open me-2"></i>Нямате направени поръчки.
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-striped text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Дата</th>
                                <th>Статус</th>
                                <th>Продукти</th>
                                <th>Общо</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @(order.Status == "Доставена" ? "bg-success" : "bg-warning text-dark")">@order.Status</span>
                                    </td>
                                    <td class="text-start">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                <li>@item.ProductName <span class="text-muted">x @item.Quantity</span></li>
                                            }
                                        </ul>
                                    </td>
                                    <td class="fw-bold">@order.TotalPrice лв</td>
                                    <td>
                                        @if (order.Status == "Доставена")
                                        {
                                            <form asp-action="DeleteOrder" method="post" class="d-inline">
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                                    <i class="fas fa-trash"></i> Изтрий
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>