@model ProductsAndCategoriesViewModel

<partial name="_Notification" />
<div class="container my-5">
    <form method="get" autocomplete="off" asp-action="OrderMenu" asp-controller="Order" class="menu-search mb-4">
        <input type="search" placeholder="Потърси продукт..." class="form-control" name="searchString" />
        <button type="submit"><i class="fas fa-search"></i></button>
    </form>

    <div class="menu-categories text-center mb-4">
        <a asp-action="OrderMenu" class="category-btn">Всички</a>
        @foreach (var category in Model.Categories)
        {
            <a asp-action="OrderMenu" asp-route-categoryId="@category.Id" class="category-btn">@category.Name</a>
        }
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var item in Model.Products)
        {
            <div class="col-12 col-sm-6 col-md-4 col-xl-3 d-flex">
                <div class="dish-card w-100">
                    <a asp-controller="Order" asp-action="ProductDetails" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                        <img src="@item.ImageUrl" alt="@item.Name" />
                        <h5>@item.Name</h5>
                        <p class="price">@item.Price лв</p>
                    </a>
                    <form asp-action="AddToCart" asp-controller="Order" method="post">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="btn-main-sm mt-2 w-100">
                            <i class="fas fa-cart-plus me-1"></i> Добави в кошницата
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>