@model ProductsAndCategoriesViewModel

<div class="hero-section menu-hero">
    <div class="hero-content">
        <h1>Нашето меню</h1>
        <p class="subtitle">Избери от нашите вкусни предложения</p>
    </div>
</div>

<div class="container my-5">
    <form asp-action="All" method="get" class="menu-search mb-4">
        <input type="text" name="searchString" class="form-control" placeholder="Търси ястие..." />
        <button type="submit"><i class="fas fa-search"></i></button>
    </form>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="admin-controls text-center mb-4">
            <a asp-action="Add" class="btn-admin"><i class="fas fa-plus"></i> Добави Ястие</a>
            <a asp-action="AddCategory" class="btn-admin"><i class="fas fa-folder-plus"></i> Добави Категория</a>
        </div>
    }
    <div class="category-wrapper">
        <a asp-action="All" class="category-btn">Всички</a>
    </div>
        @foreach (var category in Model.Categories)
        {
            <div class="category-wrapper">
                <a asp-action="All" asp-route-categoryId="@category.Id" class="category-btn">@category.Name</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="category-tools">
                        <a asp-action="EditCategory" asp-route-id="@category.Id" class="edit-icon" title="Редактирай"><i class="fas fa-pen"></i></a>
                        <a asp-action="DeleteCategory" asp-route-id="@category.Id" class="delete-icon" title="Изтрий"><i class="fas fa-trash"></i></a>
                    </div>
                }
            </div>
        }
    </div>
    <div class="row g-4 justify-content-center">
        @foreach (var item in Model.Products)
        {
            <div class="col-md-4 col-lg-3">
                <div class="dish-card">
                    <a asp-action="ProductDetails" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                        <img src="@item.ImageUrl" alt="@item.Name" />
                        <h5>@item.Name</h5>
                        <p class="price">@item.Price лв</p>
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="admin-product-btns mt-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-2">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>