@model List<Restaurant.WebApp.Data.Entities.ContactMessage>
<partial name="_Notification" />
<div class="container my-5">
    <h2 class="text-center fw-bold mb-4">Съобщения от контакт формата</h2>

    @if (!Model.Any())
    {
        <div class="text-center">
            <img src="https://cdn-icons-png.flaticon.com/512/4551/4551387.png" alt="Няма съобщения" style="width: 120px;" />
            <div class="alert alert-info d-inline-block mt-3">Няма получени съобщения.</div>
        </div>
    }
    else
    {
        <div class="row g-4 justify-content-center">
            @foreach (var message in Model)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <h5 class="card-title mb-0"><i class="bi bi-person-fill me-2"></i>@message.Email</h5>
                                <small class="text-muted">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @message.CreatedOn.ToString("dd.MM.yyyy HH:mm")
                                </small>
                            </div>

                            <p class="card-text my-3">@message.Message</p>

                            <div class="mt-auto">
                                @if (message.IsHandled)
                                {
                                    <span class="badge bg-success mb-2">
                                        <i class="bi bi-check-circle-fill me-1"></i>Обработено
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark mb-2">
                                        <i class="bi bi-hourglass-split me-1"></i>Очаква обработка
                                    </span>
                                }

                                <div class="d-flex justify-content-end gap-2">
                                    @if (!message.IsHandled)
                                    {
                                        <form asp-action="MarkAsHandled" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@message.Id" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>Обработи
                                            </button>
                                        </form>
                                    }

                                    @if (message.IsHandled && (User.IsInRole("Admin") || User.IsInRole("Manager")))
                                    {
                                        <form asp-action="DeleteMessage" method="post" class="d-inline" onsubmit="return confirm('Наистина ли искате да изтриете това съобщение?');">
                                            <input type="hidden" name="id" value="@message.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                                <i class="bi bi-trash-fill me-1"></i>Изтрий
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>