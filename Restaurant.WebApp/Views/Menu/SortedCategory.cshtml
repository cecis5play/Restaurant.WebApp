@model IEnumerable<ProductViewModel>
<div class="container-fluid">
    <div class="row" style="padding-bottom: 20px;">
        <div class="col-12">
            @Html.Partial("_SearchBar")
        </div>
    </div>
    <div class="row">
        <div class="col-2">
            <div class="shadow rounded">
                <div class="border-bottom p-2">
                    <h4 class="text-pink text-center fst-italic">Категории</h4>
                    @foreach (var category in Model)
                         {
                        <a class="text-decoration-none text-dark" asp-controller="Menu" asp-action="SortedCategory" asp-route-id="@category.Id">@category.Category</a>
                         }
                </div>
            </div>
        </div>

        @foreach (var item in Model)
        {

            <a class="card text-black text-decoration-none" style="width: 18rem;" asp-controller="Menu" asp-action="ProductDetails" asp-route-id="@item.Id">
                <img class="card-img-top" src="@item.ImageUrl/100px180/" alt="Product Image">
                <div class="card-body">
                    <h5 class="card-title" style="padding-left: 80px;">@item.Name</h5>

                </div>
            </a>
        }
    </div>
</div>