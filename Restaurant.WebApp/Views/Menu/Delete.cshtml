@model ProductDetailViewModel



<h2 class="text-center">@ViewBag.Title</h2>
<hr />
<form asp-controller="Menu" asp-action="Delete">
    <h2 class="text-center">Сигурни ли сте, че искате да изтриете @Model.Name с описание @Model.Description</h2>
    <div class="text-center">
        <input type="submit" value="Да" class="ml-2 btn btn-danger text-center" />
        <a class="ml-2 btn btn-danger" asp-controller="Menu" asp-action="ProductDetails" asp-route-id="@Model.Id">Не</a>
    </div>
</form>