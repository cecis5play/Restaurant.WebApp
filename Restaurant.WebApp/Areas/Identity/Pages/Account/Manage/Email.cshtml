@page
@model EmailModel
@{
    ViewData["Title"] = "Смяна на мейл";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="display-6 fw-bold text-dark">✉️ @ViewData["Title"]</h2>
        <p class="text-muted">Актуализирайте имейл адреса си, за да поддържате акаунта си защитен и актуален.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <partial name="_StatusMessage" for="StatusMessage" />

                    <form id="email-form" method="post">
                        

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">Текущ имейл</label>
                            <div class="input-group">
                                <input asp-for="Email" class="form-control rounded-start-pill" disabled placeholder="Вашият текущ имейл" />
                                @if (Model.IsEmailConfirmed)
                                {
                                    <span class="input-group-text bg-success text-white rounded-end-pill">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="input-group-text bg-warning text-dark rounded-end-pill">
                                        <i class="bi bi-exclamation-circle-fill"></i>
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.NewEmail" class="form-label">Нов имейл</label>
                            <input asp-for="Input.NewEmail" class="form-control rounded-pill" autocomplete="email" placeholder="Въведете нов имейл" aria-required="true" />
                            <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-main btn-lg rounded-pill">
                                <i class="bi bi-envelope-paper-fill me-2"></i> Смени имейл
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>