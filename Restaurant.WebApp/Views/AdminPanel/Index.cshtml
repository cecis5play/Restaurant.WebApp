@{
    ViewData["Title"] = "Административен Панел";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-4">Административен Панел</h1>
        <p class="text-muted lead">Управлявай съдържанието и потребителите на сайта</p>
    </div>

    <div class="row justify-content-center g-4">

        <div class="col-12 col-md-6 col-lg-4 d-flex">
            <div class="card w-100 h-100 border-0 shadow-sm text-center p-4 admin-card-hover">
                <div class="card-body">
                    <i class="fas fa-utensils fa-3x mb-3 text-primary"></i>
                    <h5 class="card-title">Меню</h5>
                    <p class="card-text small text-muted">Добавяй, редактирай или премахвай ястия.</p>
                    <a asp-controller="Menu" asp-action="All" class="btn btn-outline-primary rounded-pill mt-3 w-75">Виж менюто</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4 d-flex">
            <div class="card w-100 h-100 border-0 shadow-sm text-center p-4 admin-card-hover">
                <div class="card-body">
                    <i class="fas fa-shopping-cart fa-3x mb-3 text-success"></i>
                    <h5 class="card-title">Поръчки</h5>
                    <p class="card-text small text-muted">Следи и управлявай направените поръчки.</p>
                    <a asp-controller="Admin" asp-action="AllOrders" class="btn btn-outline-success rounded-pill mt-3 w-75">Виж поръчките</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4 d-flex">
            <div class="card w-100 h-100 border-0 shadow-sm text-center p-4 admin-card-hover">
                <div class="card-body">
                    <i class="fas fa-chair fa-3x mb-3 text-warning"></i>
                    <h5 class="card-title">Резервации</h5>
                    <p class="card-text small text-muted">Управлявай направените резервации от потребители.</p>
                    <a asp-controller="Admin" asp-action="AllReservations" class="btn btn-outline-warning rounded-pill mt-3 w-75">Виж резервациите</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4 d-flex">
            <div class="card w-100 h-100 border-0 shadow-sm text-center p-4 admin-card-hover">
                <div class="card-body">
                    <i class="fas fa-envelope fa-3x mb-3 text-info"></i>
                    <h5 class="card-title">Съобщения</h5>
                    <p class="card-text small text-muted">Провери съобщенията от контакт формата.</p>
                    <a asp-controller="AdminContact" asp-action="Index" class="btn btn-outline-info rounded-pill mt-3 w-75">Виж съобщенията</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4 d-flex">
            <div class="card w-100 h-100 border-0 shadow-sm text-center p-4 admin-card-hover">
                <div class="card-body">
                    <i class="fas fa-star fa-3x mb-3 text-secondary"></i>
                    <h5 class="card-title">Ревюта на ястия</h5>
                    <p class="card-text small text-muted">Прегледай или премахни ревюта на ястия.</p>
                    <a asp-controller="Menu" asp-action="All" class="btn btn-outline-secondary rounded-pill mt-3 w-75">Виж ревютата</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4 d-flex">
            <div class="card w-100 h-100 border-0 shadow-sm text-center p-4 admin-card-hover">
                <div class="card-body">
                    <i class="fas fa-comments fa-3x mb-3 text-dark"></i>
                    <h5 class="card-title">Ревюта на сайта</h5>
                    <p class="card-text small text-muted">Управлявай общите ревюта за сайта.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill mt-3 w-75">Виж ревютата</a>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .admin-card-hover:hover {
        transform: translateY(-5px);
        transition: 0.3s;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }
</style>