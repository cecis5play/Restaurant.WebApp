@model IEnumerable<ReservationViewModel>

<h2 class="text-center display-6 fw-bold my-4">Всички резервации</h2>

<form method="get" class="text-center mb-4">
    <div class="input-group mx-auto" style="max-width: 400px;">
        <input type="text" name="searchEmail" class="form-control rounded-start-pill" placeholder="Търси по имейл..." value="@ViewBag.SearchEmail" />
        <button type="submit" class="btn btn-outline-success rounded-end-pill">Търси</button>
    </div>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center mt-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center mt-4">
        <i class="bi bi-info-circle me-2"></i>Няма намерени резервации.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered text-center align-middle shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Потребител</th>
                    <th>Дата</th>
                    <th>Хора</th>
                    <th>Деца</th>
                    <th>Зала</th>
                    <th>Действие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.CustomerName</td>
                        <td>@r.ReservationDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.PersonNumber</td>
                        <td>@r.ChildrenNumber</td>
                        <td>@r.RoomTypeName</td>
                        <td>
                            <form method="post" asp-action="DeleteReservation">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button class="btn btn-outline-danger btn-sm rounded-pill">
                                    <i class="bi bi-trash"></i> Откажи
                                </button>

                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}