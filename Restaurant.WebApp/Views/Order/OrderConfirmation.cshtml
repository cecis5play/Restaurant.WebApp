@model OrderViewModel

<h2>Потвърждение на поръчката</h2>

<p>Благодарим Ви за Вашата поръчка, направена на @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")!</p>

<table class="table">
    <thead>
        <tr>
            <th>Име на продукта</th>
            <th>Цена</th>
            <th>Количество</th>
            <th>Общо</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>@item.Total</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-right"><strong>Обща цена:</strong></td>
            <td>@Model.TotalPrice</td>
        </tr>
    </tfoot>
</table>