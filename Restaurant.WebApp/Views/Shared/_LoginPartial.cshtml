@using Microsoft.AspNetCore.Identity
@using Restaurant.WebApp.Data.Entities
@using Restaurant.WebApp.Services
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IOrderService orderService
@{
    var userId = UserManager.GetUserId(User);
    var cartCount = SignInManager.IsSignedIn(User) ? orderService.GetCartItemCount(userId) : 0;
}

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Order" asp-action="OrderMenu"><i class="fas fa-truck me-1"></i>Поръчай</a>
    </li>
    <li class="nav-item position-relative">
        <a class="nav-link cart-icon" asp-controller="Order" asp-action="Cart">
            <i class="fas fa-shopping-cart"></i>
            @if (cartCount > 0)
            {
                <span class="cart-badge">@cartCount</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Профил"><i class="fas fa-user-circle"></i></a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login"><i class="fas fa-sign-in-alt me-1"></i>Вход</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register"><i class="fas fa-user-plus me-1"></i>Регистрация</a>
    </li>
}