@model IEnumerable<OrderViewModel>
<partial name="_Notification" />
<h2>Управление на поръчките</h2>

<table class="table">
    <thead>
        <tr>
            <th>Клиент</th>
            <th>Дата и час на поръчка</th>
            <th>Статус на доставка</th>
            <th>Артикули</th>
            <th>Обща цена</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.CustomerName</td>
                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form asp-action="UpdateStatus" method="post"> 
                        <input type="hidden" name="orderId" value="@order.Id" />
                        @Html.DropDownList("status", new SelectList(new List<SelectListItem>
                    {
                    new SelectListItem { Text = "", Value = "", Selected = order.Status == "" },
                    new SelectListItem { Text = "Доставя се", Value = "Доставя се", Selected = order.Status == "Доставя се" },
                    new SelectListItem { Text = "Доставена", Value = "Доставена", Selected = order.Status == "Доставена" }
                    }, "Value", "Text"), new { onchange = "this.form.submit();" })
                    </form>
                </td>
                <td>
                    <ul>
                        @foreach (var item in order.OrderItems)
                        {
                            <li>@item.ProductName - Количество: @item.Quantity</li>
                        }
                    </ul>
                </td>
                <td>@order.TotalPrice</td>
                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <button type="submit" class="btn btn-danger">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <div class="alert alert-warning" role="alert">
        Нямате направени поръчки.
    </div>
}