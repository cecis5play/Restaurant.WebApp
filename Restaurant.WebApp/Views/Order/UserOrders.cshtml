@model IEnumerable<OrderViewModel>
@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
    <li><a asp-area="" asp-controller="Admin" asp-action="AllOrders">Управление на поръчки</a></li>
}
<h2>Вашите поръчки</h2>
@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning" role="alert">
        Нямате направени поръчки.
    </div>
}
else
{
<table class="table">
    <thead>
        <tr>
            <th>Дата на поръчка</th>
            <th>Статус на доставка</th>
            <th>Артикули</th>
            <th>Обща цена</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>

                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@order.Status</td>
                <td>
                    <ul>
                        @foreach (var item in order.OrderItems)
                        {
                            <li>@item.ProductName - Количество: @item.Quantity</li>
                        }
                    </ul>
                </td>
                <td>@order.TotalPrice</td> <!-- Показване на общата цена -->
                <td>
                    @if (order.Status == "Доставена")
                    {
                        <form asp-action="DeleteOrder" method="post">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="btn btn-danger">Изтрий</button>
                        </form>
                    }
                </td>
                
            </tr>
        }
    </tbody>
</table>
}