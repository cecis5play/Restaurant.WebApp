@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<div class="list-group shadow-sm rounded-3">
    <a asp-action="UserOrders" asp-controller="Order" class="list-group-item list-group-item-action">
        🛒 Мойте поръчки
    </a>
    <a asp-action="UserReservations" asp-controller="Reserve" class="list-group-item list-group-item-action">
        📅 Мойте резервации
    </a>
    <a asp-page="./Index" class="list-group-item list-group-item-action @ManageNavPages.IndexNavClass(ViewContext)">
        👤 Профил
    </a>
    <a asp-page="./Email" class="list-group-item list-group-item-action @ManageNavPages.EmailNavClass(ViewContext)">
        ✉️ Имейл
    </a>
    <a asp-page="./ChangePassword" class="list-group-item list-group-item-action @ManageNavPages.ChangePasswordNavClass(ViewContext)">
        🔒 Смяна на парола
    </a>
    <a asp-page="./PersonalData" class="list-group-item list-group-item-action @ManageNavPages.PersonalDataNavClass(ViewContext)">
        🔐 Лични данни
    </a>
    <form asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
          class="text-center mt-3">
        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill">
            <i class="bi bi-box-arrow-right me-1"></i> Излез
        </button>
    </form>
</div>