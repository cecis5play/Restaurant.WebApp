@{
    ViewData["Title"] = "Резервиране";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <img src="https://cdn-icons-png.flaticon.com/512/3075/3075977.png" alt="Резервация" style="max-width: 120px;" class="mb-3">
        <h1 class="display-4 fw-bold text-dark">Резервирайте маса</h1>
        <p class="lead text-muted">Подарете си специална вечер в уютна атмосфера с превъзходна кухня и обслужване.</p>
    </div>

    <div class="text-center">
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-main btn-lg rounded-pill px-5 py-2" asp-controller="Reserve" asp-action="Add">
                <i class="bi bi-calendar-check me-2"></i> Направи резервация
            </a>
        }
        else
        {
            <div class="alert alert-warning d-inline-block px-4 py-2 rounded-pill">
                <i class="bi bi-info-circle me-2"></i>За да направите резервация, моля влезте в акаунта си.
            </div>
            <div class="mt-3">
                <a class="btn btn-outline-primary btn-sm rounded-pill me-2" asp-area="Identity" asp-page="/Account/Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Вход
                </a>
                <a class="btn btn-outline-secondary btn-sm rounded-pill" asp-area="Identity" asp-page="/Account/Register">
                    <i class="bi bi-person-plus me-1"></i> Регистрация
                </a>
            </div>
        }
    </div>
</div>

