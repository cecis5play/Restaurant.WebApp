@model ProductFormModel

@{
    ViewData["Title"] = "Редактиране на ястие";
}

<h2 class="text-center display-5 fw-bold my-4 text-dark">@ViewData["Title"]</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4">
                    <h4 class="mb-0 text-center">
                        <i class="fas fa-pen-to-square me-2"></i>Редактирай ястието
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-controller="Menu" asp-action="Edit" class="needs-validation" novalidate>
                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="Ястие..." />
                            <label asp-for="Name">Име на ястието</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control" placeholder="Описание" style="height: 120px;"></textarea>
                            <label asp-for="Description">Описание</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Price" class="form-control" placeholder="Цена" />
                            <label asp-for="Price">Цена (лв)</label>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ImageUrl" class="form-control" placeholder="URL на снимка" id="imageUrlInput" />
                            <label asp-for="ImageUrl">URL на снимка</label>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <!-- Image preview -->
                        <div class="text-center mb-4" id="imagePreviewContainer" style="display:none;">
                            <img id="imagePreview" src="" alt="Преглед на изображението" class="img-fluid rounded shadow-sm" style="max-height: 250px;" />
                        </div>

                        <div class="form-floating mb-4">
                            <select asp-for="CategoryId" class="form-select">
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <label asp-for="CategoryId">Категория</label>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm">
                            <i class="fas fa-save me-2"></i>Запази промените
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.getElementById('imageUrlInput');
        const img = document.getElementById('imagePreview');
        const previewContainer = document.getElementById('imagePreviewContainer');

        input.addEventListener('input', () => {
            const url = input.value.trim();
            if (url !== "") {
                img.src = url;
                previewContainer.style.display = 'block';
            } else {
                previewContainer.style.display = 'none';
            }
        });

        // Автоматичен preview при заредена стойност (например при Edit)
        window.addEventListener('DOMContentLoaded', () => {
            if (input.value.trim() !== "") {
                img.src = input.value;
                previewContainer.style.display = 'block';
            }
        });
    </script>
}