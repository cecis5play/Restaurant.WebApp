@using Microsoft.AspNetCore.Identity
@model ProductDetailViewModel

<h2 class="text-center">@ViewBag.Title</h2>


<div class="card text-center mx-auto" style="width: 30rem;">
    <div class="card-body">
        <img class="card-img-top" src="@Model.ImageUrl" alt="Product Image">
        <h5 class="card-title" style="font-size: xxx-large;font-family: ui-monospace;">@Model.Name</h5>
        <p class="card-text" style="  font-size: xx-large;">@Model.Description</p>
    </div>
 </div>
