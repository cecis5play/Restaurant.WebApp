@model IEnumerable<ProductViewModel> 
@{
    ViewBag.Title = "Меню";
}

<h2 class="text-center">@ViewBag.Title</h2>
<hr />
<div class="row" style="padding-top: 30px">
       @foreach(var item in Model)
    {
        <div class="row" style="padding-top: 30px">
            <a class="card text-black text-decoration-none" style="width: 18rem;" asp-controller="Menu" asp-action="ProductDetails" asp-route-id="@item.Id">
                <img class="card-img-top" src="@item.ImageUrl/100px180/" alt="Product Image">
                <div class="card-body">
                    <h5 class="card-title" style="padding-left: 80px;">@item.Name</h5>
                
                </div>
        </a>
        </div>
    }
</div>