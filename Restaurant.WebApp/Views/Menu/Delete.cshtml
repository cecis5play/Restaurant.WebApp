@model ProductDetailViewModel

@{
    ViewData["Title"] = "Изтриване на ястие";
}

<h2 class="text-center text-danger fw-bold display-6 my-4">
    <i class="fas fa-trash-alt me-2"></i>@ViewData["Title"]
</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 text-center">
                    <h4 class="text-dark mb-3">Сигурни ли сте, че искате да изтриете следното ястие?</h4>

                    <div class="mb-4">
                        <h5 class="fw-bold">@Model.Name</h5>
                        <p class="text-muted">@Model.Description</p>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm mt-3" style="max-height: 250px;" />
                        }
                    </div>

                    <form asp-controller="Menu" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill px-4 shadow-sm">
                                <i class="fas fa-check-circle me-2"></i>Да, изтрий
                            </button>
                            <a class="btn btn-outline-secondary btn-lg rounded-pill px-4 shadow-sm"
                               asp-controller="Menu"
                               asp-action="ProductDetails"
                               asp-route-id="@Model.Id">
                                <i class="fas fa-times-circle me-2"></i>Не, върни се
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>