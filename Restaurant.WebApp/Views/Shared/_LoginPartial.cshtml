@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
        @if (this.User?.Identity?.IsAuthenticated == true)
        {
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="OrderMenu">Поръчай за вкъщи</a>
                </li>
            </ul>
        }
    <li class="nav-item">
            <a class="nav-link text-dark bi bi-person-fill" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"></a>
    </li>
}
else
{
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Регистрирай се</a>
    </li>
}
</ul>
